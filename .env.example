# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is ignored by git. Never commit it.

# --- Docker settings ---
# Host port for the web UI
PORT=5050
# Host user and group that own the saved PDFs (run `id -u` and `id -g`)
PUID=1000
PGID=1000
# Host folder where invoices are stored
FACTURAS_HOST_DIR=./facturas

# --- Issuer (Emisor) ---
EMITTER_NAME=Jane Doe
EMITTER_TAX_ID=11.111.111-1
EMITTER_EMAIL=jane.doe@example.com

# --- Client (Cliente) ---
CLIENT_NAME=Example Client LLC
CLIENT_ADDRESS=123 Example St, Springfield, USA

# --- Payment details (Datos de Pago) ---
BANK_NAME=Example Bank
BANK_ACCOUNT_TYPE=Checking (USD)
BANK_ACCOUNT_NUMBER=00-000-00000-00
BANK_ACCOUNT_HOLDER=Jane Doe
BANK_ACCOUNT_HOLDER_TAX_ID=11.111.111-1

# --- Invoice defaults ---
DEFAULT_HOURLY_RATE=25
